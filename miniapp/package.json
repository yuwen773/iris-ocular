{
  "name": "iris-miniapp",
  "version": "0.1.0",
  "private": true,
  "description": "Iris 患者端微信小程序（体验版先行）",
  "scripts": {
    "gen:tokens": "node scripts/gen-tokens.mjs",
    "dev:weapp": "npm run gen:tokens && taro build --type weapp --watch",
    "build:weapp": "npm run gen:tokens && taro build --type weapp",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "dependencies": {
    "@babel/runtime": "^7.26.0",
    "@tarojs/components": "^4.0.0",
    "@tarojs/helper": "^4.0.0",
    "@tarojs/plugin-framework-react": "^4.0.0",
    "@tarojs/plugin-platform-weapp": "^4.0.0",
    "@tarojs/react": "^4.0.0",
    "@tarojs/runtime": "^4.0.0",
    "@tarojs/shared": "^4.0.0",
    "@tarojs/taro": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-react": "^7.29.7",
    "@tarojs/cli": "^4.0.0",
    "@tarojs/webpack5-runner": "^4.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "babel-preset-taro": "^4.0.0",
    "miniprogram-api-typings": "^3.12.0",
    "sass": "^1.83.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "webpack": "5.91.0"
  }
}
